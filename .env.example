META_API_KEY=
# Optional overrides (META_BASE_URL is the base only, without /chat/completions):
# META_MODEL=muse-spark-1.3
# META_BASE_URL=https://api.meta.ai/v1
# (Alternative OpenAI-compatible base: https://api.llama.com/compat/v1)
# PORT=5000
# MAX_UPLOAD_MB=8
# RATE_LIMIT_EXPLAIN=10
# RATE_LIMIT_ASK=30
# MAX_QUESTION_CHARS=2000
# MAX_EXPLANATION_CHARS=8000
# MAX_ASK_IMAGE_MB=8
# Require browsers to send this token as an X-LB-Token header (see explain.html):
# Visible to every visitor via /lb-config.js: NOT real authentication, only casual-script blocking.
# LB_API_TOKEN=change-me-to-a-long-random-value
# Honour X-Forwarded-For for rate limits (only behind a proxy you control):
# TRUST_PROXY=1
